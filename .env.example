# ---- Backend (apps/api) ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production

# SQLite for dev; Postgres for prod
DATABASE_URL=sqlite:///./angaza.db

# AI provider: mock | deepseek | foundry
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=

# Simulation defaults
MATCH_SEED=42
MATCH_SCENARIO=balanced
MATCH_TICK_SECONDS=1

# Auth
JWT_SECRET=change-me-too
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# ---- Frontend (apps/web) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
